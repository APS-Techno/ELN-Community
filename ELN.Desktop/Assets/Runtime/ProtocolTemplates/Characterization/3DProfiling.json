{
  "version": 1,
  "title": "3D Profiling Protocol",
  "description": "Surface profilometry and thickness measurement protocol",
  "category": "Characterization",
  "accentColor": "#3498db",
  "sections": [
    {
      "title": "Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Instrument", "placeholder": "e.g. Filmetrics Profilm3D", "autoFill": "equipment.model" },
            { "name": "sampleId", "type": "text", "label": "Sample ID", "autoFill": "parent.title" }
          ]
        },
        {
          "fields": [
            { "name": "manufacturer", "type": "text", "label": "Manufacturer", "autoFill": "equipment.manufacturer" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        }
      ]
    },
    {
      "title": "Measurement Parameters",
      "rows": [
        {
          "fields": [
            { "name": "mode", "type": "select", "label": "Mode", "options": [
              { "value": "wli", "label": "White Light Interferometry" },
              { "value": "psi", "label": "Phase Shifting (PSI)" },
              { "value": "vsi", "label": "Vertical Scanning (VSI)" },
              { "value": "contact", "label": "Contact Stylus" }
            ]},
            { "name": "objective", "type": "text", "label": "Objective", "placeholder": "e.g. 10x, 50x" }
          ]
        },
        {
          "fields": [
            { "name": "scanArea", "type": "text", "label": "Scan Area", "placeholder": "e.g. 1 x 1 mm" },
            { "name": "resolution", "type": "text", "label": "Lateral Resolution", "placeholder": "e.g. 1 um" }
          ]
        },
        {
          "fields": [
            { "name": "scanLength", "type": "text", "label": "Scan Length (mm)", "placeholder": "e.g. 1" },
            { "name": "stylusForce", "type": "text", "label": "Stylus Force (mg)", "placeholder": "e.g. 1" }
          ]
        },
        {
          "fields": [
            { "name": "positions", "type": "text", "label": "Measurement Positions", "placeholder": "e.g. Left, Center, Right" }
          ]
        }
      ]
    },
    {
      "title": "Results",
      "rows": [
        {
          "fields": [
            { "name": "results", "type": "text", "label": "Results", "autoFill": "results.all" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "autoFill": "user.name" },
            { "name": "date", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
