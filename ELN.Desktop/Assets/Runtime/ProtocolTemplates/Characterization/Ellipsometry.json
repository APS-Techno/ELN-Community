{
  "version": 1,
  "title": "Ellipsometry Protocol",
  "description": "Spectroscopic ellipsometry measurement protocol for thin film characterization",
  "category": "Characterization",
  "accentColor": "#3498db",
  "sections": [
    {
      "title": "Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Instrument", "placeholder": "e.g. J.A. Woollam M-2000", "autoFill": "equipment.model" },
            { "name": "sampleId", "type": "text", "label": "Sample ID", "autoFill": "parent.title" }
          ]
        },
        {
          "fields": [
            { "name": "manufacturer", "type": "text", "label": "Manufacturer", "autoFill": "equipment.manufacturer" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        }
      ]
    },
    {
      "title": "Measurement Parameters",
      "rows": [
        {
          "fields": [
            { "name": "wavelengthRange", "type": "text", "label": "Wavelength Range (nm)", "placeholder": "e.g. 245 - 1700" },
            { "name": "angle", "type": "text", "label": "Angle of Incidence (deg)", "placeholder": "e.g. 65, 70, 75" }
          ]
        },
        {
          "fields": [
            { "name": "spotSize", "type": "text", "label": "Spot Size (mm)", "placeholder": "e.g. 2 x 5" },
            { "name": "acquisitionTime", "type": "text", "label": "Acquisition Time (s)", "placeholder": "e.g. 10" }
          ]
        },
        {
          "fields": [
            { "name": "substrate", "type": "text", "label": "Substrate", "placeholder": "e.g. Si (100), glass" },
            { "name": "numberOfPoints", "type": "text", "label": "Measurement Points", "placeholder": "e.g. 5 (mapping)" }
          ]
        }
      ]
    },
    {
      "title": "Model & Fitting",
      "rows": [
        {
          "fields": [
            { "name": "opticalModel", "type": "text", "label": "Optical Model", "placeholder": "e.g. Cauchy, B-Spline, Tauc-Lorentz" },
            { "name": "fitQuality", "type": "text", "label": "Fit Quality (MSE)", "placeholder": "e.g. 2.5" }
          ]
        },
        {
          "fields": [
            { "name": "thickness", "type": "text", "label": "Thickness (nm)", "placeholder": "e.g. 150.3 +/- 0.5" },
            { "name": "refractiveIndex", "type": "text", "label": "Refractive Index (at 632.8 nm)", "placeholder": "e.g. 2.15" }
          ]
        }
      ]
    },
    {
      "title": "Results",
      "rows": [
        {
          "fields": [
            { "name": "results", "type": "text", "label": "All Results", "autoFill": "results.all" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "autoFill": "user.name" },
            { "name": "date", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
