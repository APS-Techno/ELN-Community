{
  "version": 1,
  "title": "XRD Protocol",
  "description": "X-ray diffraction measurement protocol",
  "category": "Characterization",
  "accentColor": "#3498db",
  "sections": [
    {
      "title": "Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Instrument", "placeholder": "e.g. Bruker D8 Discover", "autoFill": "equipment.model" },
            { "name": "sampleId", "type": "text", "label": "Sample ID", "autoFill": "parent.title" }
          ]
        },
        {
          "fields": [
            { "name": "manufacturer", "type": "text", "label": "Manufacturer", "autoFill": "equipment.manufacturer" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        },
        {
          "fields": [
            { "name": "radiation", "type": "select", "label": "X-ray Source", "options": [
              { "value": "CuKa", "label": "Cu Ka (1.5406 A)" },
              { "value": "MoKa", "label": "Mo Ka (0.7107 A)" },
              { "value": "CoKa", "label": "Co Ka (1.7890 A)" },
              { "value": "CrKa", "label": "Cr Ka (2.2910 A)" }
            ]},
            { "name": "optics", "type": "text", "label": "Optics / Monochromator", "placeholder": "e.g. Goebel mirror, Ge(220) 2-bounce" }
          ]
        }
      ]
    },
    {
      "title": "Scan Parameters",
      "rows": [
        {
          "fields": [
            { "name": "scanType", "type": "select", "label": "Scan Type", "options": [
              { "value": "theta-2theta", "label": "Theta-2Theta" },
              { "value": "grazing", "label": "Grazing Incidence" },
              { "value": "rocking", "label": "Rocking Curve" },
              { "value": "phi", "label": "Phi Scan" },
              { "value": "rsm", "label": "Reciprocal Space Map" }
            ]},
            { "name": "detector", "type": "text", "label": "Detector", "placeholder": "e.g. LynxEye, Scintillation" }
          ]
        },
        {
          "fields": [
            { "name": "startAngle", "type": "text", "label": "Start Angle (deg)", "placeholder": "e.g. 10" },
            { "name": "endAngle", "type": "text", "label": "End Angle (deg)", "placeholder": "e.g. 90" }
          ]
        },
        {
          "fields": [
            { "name": "stepSize", "type": "text", "label": "Step Size (deg)", "placeholder": "e.g. 0.02" },
            { "name": "timePerStep", "type": "text", "label": "Time per Step (s)", "placeholder": "e.g. 1" }
          ]
        },
        {
          "fields": [
            { "name": "voltage", "type": "text", "label": "Voltage (kV)", "placeholder": "e.g. 40" },
            { "name": "current", "type": "text", "label": "Current (mA)", "placeholder": "e.g. 40" }
          ]
        }
      ]
    },
    {
      "title": "Results",
      "rows": [
        {
          "fields": [
            { "name": "results", "type": "text", "label": "Results", "autoFill": "results.all" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "autoFill": "user.name" },
            { "name": "date", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
