{
  "version": 1,
  "title": "XRF Daily Performance Check",
  "description": "Routine daily verification of XRF instrument performance with drift monitor",
  "category": "Characterization",
  "accentColor": "#3498db",
  "sections": [
    {
      "title": "Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Instrument", "autoFill": "equipment.model" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "autoFill": "user.name" },
            { "name": "date", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Drift Monitor",
      "rows": [
        {
          "fields": [
            { "name": "monitorId", "type": "text", "label": "Monitor Sample ID", "placeholder": "e.g. DM-001, Drift-Cu" },
            { "name": "monitorMaterial", "type": "text", "label": "Monitor Material", "placeholder": "e.g. Cu alloy, stainless steel 316" }
          ]
        },
        {
          "fields": [
            { "name": "channelsChecked", "type": "text", "label": "Channels / Lines Checked", "placeholder": "e.g. Cu-Ka, Fe-Ka, Cr-Ka" },
            { "name": "measurementTime", "type": "text", "label": "Measurement Time (s)", "placeholder": "e.g. 60" }
          ]
        }
      ]
    },
    {
      "title": "Results",
      "rows": [
        {
          "fields": [
            { "name": "intensityValues", "type": "textarea", "label": "Measured Intensities (kcps)", "rows": 3, "placeholder": "Cu-Ka: 125.3 (ref: 126.0)\nFe-Ka: 89.7 (ref: 90.1)\nCr-Ka: 45.2 (ref: 45.5)" }
          ]
        },
        {
          "fields": [
            { "name": "maxDrift", "type": "text", "label": "Max Drift (%)", "placeholder": "e.g. 0.5" },
            { "name": "outcome", "type": "select", "label": "Outcome", "options": [
              { "value": "pass", "label": "Pass (within tolerance)" },
              { "value": "warning", "label": "Warning (marginal)" },
              { "value": "fail", "label": "Fail (recalibration needed)" }
            ]}
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
