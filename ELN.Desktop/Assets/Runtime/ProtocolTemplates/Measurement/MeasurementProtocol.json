{
  "version": 1,
  "title": "Measurement Protocol",
  "description": "General measurement and characterization protocol",
  "category": "Measurement",
  "accentColor": "#00897b",
  "sections": [
    {
      "title": "Measurement Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Instrument", "placeholder": "e.g. XRD Bruker D8", "autoFill": "equipment.model" },
            { "name": "sampleId", "type": "text", "label": "Sample ID", "placeholder": "e.g. S-2026-001", "autoFill": "parent.title" }
          ]
        },
        {
          "fields": [
            { "name": "manufacturer", "type": "text", "label": "Manufacturer", "autoFill": "equipment.manufacturer" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        },
        {
          "fields": [
            { "name": "results", "type": "text", "label": "Results", "autoFill": "results.all" }
          ]
        },
        {
          "fields": [
            { "name": "temperature", "type": "text", "label": "Temperature (C)", "placeholder": "e.g. RT" },
            { "name": "atmosphere", "type": "text", "label": "Atmosphere", "placeholder": "e.g. Air, Vacuum, N2" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "placeholder": "Name", "autoFill": "user.name" },
            { "name": "measurementDate", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
