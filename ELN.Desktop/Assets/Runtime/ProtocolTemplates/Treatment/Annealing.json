{
  "version": 1,
  "title": "Annealing Protocol",
  "description": "Thermal annealing / heat treatment protocol",
  "category": "Treatment",
  "accentColor": "#e65100",
  "sections": [
    {
      "title": "Setup",
      "rows": [
        {
          "fields": [
            { "name": "instrument", "type": "text", "label": "Furnace / Oven", "placeholder": "e.g. Carbolite CWF 1300", "autoFill": "equipment.model" },
            { "name": "sampleId", "type": "text", "label": "Sample ID", "autoFill": "parent.title" }
          ]
        },
        {
          "fields": [
            { "name": "manufacturer", "type": "text", "label": "Manufacturer", "autoFill": "equipment.manufacturer" },
            { "name": "location", "type": "text", "label": "Location", "autoFill": "equipment.location" }
          ]
        }
      ]
    },
    {
      "title": "Annealing Parameters",
      "rows": [
        {
          "fields": [
            { "name": "temperature", "type": "text", "label": "Temperature (C)", "placeholder": "e.g. 500", "autoFill": "conditions.T" },
            { "name": "duration", "type": "text", "label": "Duration", "placeholder": "e.g. 2 h", "autoFill": "conditions.t" }
          ]
        },
        {
          "fields": [
            { "name": "heatingRate", "type": "text", "label": "Heating Rate (C/min)", "placeholder": "e.g. 10" },
            { "name": "coolingMethod", "type": "select", "label": "Cooling Method", "options": [
              { "value": "furnace", "label": "Furnace Cooling" },
              { "value": "air", "label": "Air Cooling" },
              { "value": "water", "label": "Water Quench" },
              { "value": "oil", "label": "Oil Quench" },
              { "value": "controlled", "label": "Controlled Rate" }
            ]}
          ]
        },
        {
          "fields": [
            { "name": "atmosphere", "type": "select", "label": "Atmosphere", "options": [
              { "value": "air", "label": "Air" },
              { "value": "vacuum", "label": "Vacuum" },
              { "value": "argon", "label": "Argon" },
              { "value": "nitrogen", "label": "Nitrogen" },
              { "value": "forming-gas", "label": "Forming Gas (N2/H2)" }
            ]},
            { "name": "pressure", "type": "text", "label": "Pressure", "placeholder": "e.g. 1 atm, 5e-5 mbar", "autoFill": "conditions.P" }
          ]
        },
        {
          "fields": [
            { "name": "coolingRate", "type": "text", "label": "Cooling Rate (C/min)", "placeholder": "e.g. 5 (if controlled)" },
            { "name": "holdSteps", "type": "text", "label": "Hold Steps", "placeholder": "e.g. 200C/30min + 500C/2h" }
          ]
        }
      ]
    },
    {
      "title": "Results",
      "rows": [
        {
          "fields": [
            { "name": "results", "type": "text", "label": "All Results", "autoFill": "results.all" }
          ]
        },
        {
          "fields": [
            { "name": "operator", "type": "text", "label": "Operator", "autoFill": "user.name" },
            { "name": "date", "type": "date", "label": "Date", "autoFill": "date.today" }
          ]
        }
      ]
    },
    {
      "title": "Notes",
      "rows": [
        {
          "fields": [
            { "name": "notes", "type": "richtext", "label": "Notes", "rows": 3 }
          ]
        }
      ]
    }
  ]
}
