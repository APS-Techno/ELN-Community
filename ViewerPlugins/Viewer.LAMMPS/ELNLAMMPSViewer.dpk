package ELNLAMMPSViewer;

{$R *.res}
{$IFDEF IMPLICITBUILDING This SHOULD NOT BE EDITED MANUALLY}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclimg,
  vclwinx,
  RaizeComponentsVcl,
  TMSVCLPluginFrameworkPkgCore,
  ELNPluginCore,
  SynEditDR,
  Tee;

contains
  unit_LAMMPSPlugin in 'unit_LAMMPSPlugin.pas' {ELNLAMMPSViewerPlugin: TupfVisualPlugin},
  frame_LAMMPSViewer in 'frame_LAMMPSViewer.pas' {frameLAMMPSViewer: TFrame},
  unit_LAMMPSDumpParser in 'unit_LAMMPSDumpParser.pas';

end.
