<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <ELN_ProductRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</ELN_ProductRoot>
    <ELN_OutputRoot>$(ELN_ProductRoot)\_OUT\ViewerTests\test_PreviewText\$(Platform)\$(Config)</ELN_OutputRoot>
    <ELN_TmsRoot Condition="'$(ELN_TmsRoot)'==''">$(ELN_TMS_ROOT)</ELN_TmsRoot>
    <ELN_ExternalUnitPaths Condition="'$(ELN_ExternalUnitPaths)'==''">$(ELN_EXTERNAL_UNIT_PATHS)</ELN_ExternalUnitPaths>
    <ELN_ExternalUnitPaths Condition="'$(ELN_TmsRoot)'!=''">$(ELN_ExternalUnitPaths);$(ELN_TmsRoot)\tms.biz.aurelius\packages\d13\$(Platform)\$(Config);$(ELN_TmsRoot)\tms.biz.bcl\packages\d13\$(Platform)\$(Config)</ELN_ExternalUnitPaths>
    <DCC_UnitSearchPath>$(ELN_OutputRoot)\Packages;$(ELN_ProductRoot)\ViewerPlugins\Core;$(ELN_ProductRoot)\ViewerPlugins\Core.Protocol;$(MSBuildProjectDirectory);..;$(ELN_ExternalUnitPaths)</DCC_UnitSearchPath>
    <DCC_DcpOutput>$(ELN_OutputRoot)\Packages</DCC_DcpOutput>
    <DCC_BplOutput>$(ELN_OutputRoot)</DCC_BplOutput>
    <DCC_HppOutput>$(ELN_OutputRoot)\Hpp</DCC_HppOutput>
    <DCC_ResourceOutput>$(ELN_OutputRoot)\Resources</DCC_ResourceOutput>
    <PreBuildEvent/>
    <PostBuildEvent/>
    <PreLinkEvent/>
  </PropertyGroup>
  <PropertyGroup>
    <ProjectGuid>{3C1F7A94-2E5B-4D68-B0A3-9F4C6D51E8B7}</ProjectGuid>
    <MainSource>test_PreviewText.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform>Win32</Platform>
    <AppType>Console</AppType>
    <FrameworkType>None</FrameworkType>
    <ProjectVersion>20.3</ProjectVersion>
    <TargetedPlatforms>3</TargetedPlatforms>
    <DCC_DependencyCheckOutputName>test_PreviewText.exe</DCC_DependencyCheckOutputName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
